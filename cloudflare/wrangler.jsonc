{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "enticket-drive",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/instagram-media/*",
      "/verify",
      "/upload",
      "/stamp",
      "/healthz"
    ]
  },
  "main": "src/worker.mjs",
  "keep_vars": true,
  "durable_objects": {
    "bindings": [{ "name": "LOGIN_SESSIONS", "class_name": "LoginSession" }, { "name": "INSTAGRAM_JOBS", "class_name": "InstagramJob" }]
  },
  "migrations": [{ "tag": "instagram-v1", "new_sqlite_classes": ["InstagramJob"] }, { "tag": "login-v1", "new_sqlite_classes": ["LoginSession"] }],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "tools.enticket.kr",
      "custom_domain": true
    }
  ]
}
